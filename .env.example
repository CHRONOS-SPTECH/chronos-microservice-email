# Valores locais de desenvolvimento; nunca coloque credenciais reais neste arquivo.
SERVER_PORT=8081

# RabbitMQ local (docker compose)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
EMAIL_RABBITMQ_ENABLED=true
EMAIL_RABBITMQ_EXCHANGE=email.exchange
EMAIL_RABBITMQ_QUEUE=email.send.queue
EMAIL_RABBITMQ_ROUTING_KEY=email.send
EMAIL_RABBITMQ_DLX=email.dlx
EMAIL_RABBITMQ_DLQ=email.send.dlq
EMAIL_RABBITMQ_DLQ_ROUTING_KEY=email.send.dead

# MailDev local
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
EMAIL_FROM=remetente@localhost

# Configure para o MySQL local. Senha vazia é adequada somente se seu MySQL permitir.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/msemail?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
